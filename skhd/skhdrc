# focus windows (arrow keys)
alt - right : yabai -m window --focus east
alt - left  : yabai -m window --focus west
alt - down  : yabai -m window --focus south
alt - up    : yabai -m window --focus north

# move windows
shift + alt - right : yabai -m window --warp east
shift + alt - left  : yabai -m window --warp west
shift + alt - down  : yabai -m window --warp south
shift + alt - up    : yabai -m window --warp north

# --- WORKSPACES (SPACES) ---

# move window to next/prev space and follow it
alt + cmd - right : yabai -m window --space next; yabai -m space --focus next
alt + cmd - left  : yabai -m window --space prev; yabai -m space --focus prev


# focus next/prev space
ctrl + alt - right : yabai -m space --focus next
ctrl + alt - left  : yabai -m space --focus prev


# --- WINDOW STATES ---

# toggle fullscreen (native macOS fullscreen)
alt - return : yabai -m window --toggle zoom-fullscreen

# toggle float
alt - space : yabai -m window --toggle float


# --- RESIZE ---

# resize horizontally (adjust amount if needed)
ctrl + alt + cmd - right : yabai -m window --resize right:50:0
ctrl + alt + cmd - left  : yabai -m window --resize left:-50:0


# --- LAYOUT ---

# balance / equalize windows
alt + cmd - h : yabai -m space --balance

