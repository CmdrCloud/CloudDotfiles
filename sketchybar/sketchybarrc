# SketchyBar Configuration with Floating Island Design
# Inspired by macOS-style floating widgets

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Transparent bar to let the floating islands stand out
sketchybar --bar position=top \
                 height=40 \
                 blur_radius=30 \
                 color=0x00000000 \
                 padding_left=10 \
                 padding_right=10 \
                 display=all

##### Changing Defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="CaskaydiaCove Nerd Font:Semibold:15.0"
  label.font="CaskaydiaCove Nerd Font:Semibold:13.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=6
  icon.padding_right=6
  label.padding_left=6
  label.padding_right=6
  background.corner_radius=9
  background.height=28
)
sketchybar --default "${default[@]}"

##### Left Side - Floating Workspace Island #####
# Aerospace workspace compatibility
sketchybar --add event aerospace_workspace_change

# Create a bracket for the workspace island
sketchybar --add item workspace_island_spacer_left left \
           --set workspace_island_spacer_left \
                 icon.drawing=off \
                 label.drawing=off \
                 background.drawing=off \
                 width=10

# Add aerospace workspaces
for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.color=0x00ffffff \
        background.corner_radius=7 \
        background.height=24 \
        background.drawing=off \
        label="$sid" \
        label.font="SF Pro:Bold:13.0" \
        icon.drawing=off \
        padding_left=8 \
        padding_right=8 \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

sketchybar --add item workspace_island_spacer_right left \
           --set workspace_island_spacer_right \
                 icon.drawing=off \
                 label.drawing=off \
                 background.drawing=off \
                 width=10

# Create bracket for floating island effect
workspace_items=$(aerospace list-workspaces --all | sed 's/^/space./' | tr '\n' ' ')
sketchybar --add bracket workspace_island $workspace_items \
           --set workspace_island \
                 background.color=0xff1e1e2e \
                 background.corner_radius=12 \
                 background.height=32 \
                 background.border_width=1 \
                 background.border_color=0xff313244

##### Center - Front App Display #####
sketchybar --add item front_app center \
           --set front_app \
                 icon.drawing=off \
                 label.font="SF Pro:Semibold:13.0" \
                 background.color=0xff1e1e2e \
                 background.corner_radius=12 \
                 background.height=32 \
                 background.border_width=1 \
                 background.border_color=0xff313244 \
                 padding_left=15 \
                 padding_right=15 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Right Side - System Info Islands #####
# Volume item
sketchybar --add item volume right \
           --set volume \
                 icon=󰕾 \
                 icon.font="SF Pro:Semibold:16.0" \
                 background.color=0xff1e1e2e \
                 background.corner_radius=12 \
                 background.height=32 \
                 background.border_width=1 \
                 background.border_color=0xff313244 \
                 padding_left=12 \
                 padding_right=12 \
                 script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

# Spacer
sketchybar --add item right_spacer1 right \
           --set right_spacer1 \
                 width=8 \
                 background.drawing=off

# Battery item
sketchybar --add item battery right \
           --set battery \
                 update_freq=120 \
                 icon.font="SF Pro:Semibold:16.0" \
                 background.color=0xff1e1e2e \
                 background.corner_radius=12 \
                 background.height=32 \
                 background.border_width=1 \
                 background.border_color=0xff313244 \
                 padding_left=12 \
                 padding_right=12 \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

# Spacer
sketchybar --add item right_spacer2 right \
           --set right_spacer2 \
                 width=8 \
                 background.drawing=off

# Clock item (rightmost)
sketchybar --add item clock right \
           --set clock \
                 update_freq=10 \
                 icon= \
                 icon.font="SF Pro:Semibold:16.0" \
                 label.font="SF Pro:Semibold:13.0" \
                 background.color=0xff1e1e2e \
                 background.corner_radius=12 \
                 background.height=32 \
                 background.border_width=1 \
                 background.border_color=0xff313244 \
                 padding_left=12 \
                 padding_right=12 \
                 script="$PLUGIN_DIR/clock.sh"

##### Force all scripts to run #####
sketchybar --update
