#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

# ╔══════════════════════════════════════════════════════╗
# ║          Catppuccin Mocha — Color Palette            ║
# ╚══════════════════════════════════════════════════════╝
# Base     0xff1e1e2e    Mantle   0xff181825
# Surface0 0xff313244    Surface1 0xff45475a
# Overlay0 0xff6c7086    Overlay2 0xff9399b2
# Text     0xffcdd6f4    Subtext1 0xffbac2de
# Mauve    0xffcba6f7    Blue     0xff89b4fa
# Lavender 0xffb4befe    Sapphire 0xff74c7ec
# Sky      0xff89dceb    Teal     0xff94e2d5
# Green    0xffa6e3a1    Yellow   0xfff9e2af
# Peach    0xfffab387    Red      0xfff38ba8
# Pink     0xfff5c2e7    Flamingo 0xfff2cdcd

##### Bar ################################################################
sketchybar --bar \
  position=top \
  height=40 \
  blur_radius=0 \
  color=0x00000000 \
  padding_left=12 \
  padding_right=12 \
  display=all

##### Defaults ###########################################################
sketchybar --default \
  padding_left=4 \
  padding_right=4 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:18.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:12.0" \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  icon.padding_left=8 \
  icon.padding_right=4 \
  label.padding_left=4 \
  label.padding_right=8 \
  background.corner_radius=10 \
  background.height=30

# ════════════════════════════════════════════════════════
#  LEFT — Workspace Island
# ════════════════════════════════════════════════════════

sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
    background.color=0x00ffffff \
    background.corner_radius=8 \
    background.height=26 \
    background.drawing=on \
    background.border_width=0 \
    label="$sid" \
    label.font="CaskaydiaCove Nerd Font Mono:Bold:12.0" \
    label.color=0xff9399b2 \
    icon.drawing=off \
    padding_left=3 \
    padding_right=3 \
    click_script="aerospace workspace $sid" \
    script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

# Bracket wraps all workspace items into a pill island
workspace_items=$(aerospace list-workspaces --all | sed 's/^/space./' | tr '\n' ' ')
sketchybar --add bracket workspace_island $workspace_items \
  --set workspace_island \
  background.color=0xff1e1e2e \
  background.corner_radius=12 \
  background.height=34 \
  background.border_width=1 \
  background.border_color=0xff45475a

# ════════════════════════════════════════════════════════
#  LEFT — Front App Name
# ════════════════════════════════════════════════════════

sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  label.font="CaskaydiaCove Nerd Font Mono:Semibold:12.0" \
  label.color=0xffcdd6f4 \
  background.color=0xff1e1e2e \
  background.corner_radius=12 \
  background.height=34 \
  background.border_width=1 \
  background.border_color=0xff45475a \
  padding_left=14 \
  padding_right=14 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# ════════════════════════════════════════════════════════
#  RIGHT — System Islands (right-to-left order)
# ════════════════════════════════════════════════════════

# ── Clock (rightmost) ──────────────────────────────────
sketchybar --add item clock right \
  --set clock \
  update_freq=10 \
  icon= \
  icon.color=0xff89b4fa \
  icon.font="CaskaydiaCove Nerd Font Mono:Semibold:14.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Semibold:12.0" \
  label.color=0xffcdd6f4 \
  background.color=0xff1e1e2e \
  background.corner_radius=12 \
  background.height=34 \
  background.border_width=1 \
  background.border_color=0xff45475a \
  padding_left=12 \
  padding_right=12 \
  script="$PLUGIN_DIR/clock.sh"

sketchybar --add item spacer_r1 right \
  --set spacer_r1 width=6 background.drawing=off

# ── Battery ────────────────────────────────────────────
sketchybar --add item battery right \
  --set battery \
  update_freq=120 \
  icon.color=0xffa6e3a1 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:15.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:12.0" \
  label.color=0xffcdd6f4 \
  background.color=0xff1e1e2e \
  background.corner_radius=12 \
  background.height=34 \
  background.border_width=1 \
  background.border_color=0xff45475a \
  padding_left=12 \
  padding_right=12 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --add item spacer_r2 right \
  --set spacer_r2 width=6 background.drawing=off

# ── Volume ─────────────────────────────────────────────
sketchybar --add item volume right \
  --set volume \
  icon=󰕾 \
  icon.color=0xffcba6f7 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:15.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:12.0" \
  label.color=0xffcdd6f4 \
  background.color=0xff1e1e2e \
  background.corner_radius=12 \
  background.height=34 \
  background.border_width=1 \
  background.border_color=0xff45475a \
  padding_left=12 \
  padding_right=12 \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

sketchybar --add item spacer_r3 right \
  --set spacer_r3 width=6 background.drawing=off

##### Force all scripts to run ###########################################
sketchybar --update
