#!/bin/bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar ################################################################
sketchybar --bar \
  position=top \
  height=37 \
  color=0x00000000 \
  shadow=off \
  padding_left=11 \
  padding_right=11 \
  display=all

##### Defaults ###########################################################
sketchybar --default \
  padding_left=3 \
  padding_right=3 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:13.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Medium:12.0" \
  icon.color=0xddffffff \
  label.color=0xddffffff \
  icon.padding_left=0 \
  icon.padding_right=4 \
  label.padding_left=0 \
  label.padding_right=0 \
  background.drawing=off \
  label.y_offset=0 \
  icon.y_offset=0

# ════════════════════════════════════════════════════════
#  LEFT — Workspace dots  (subtle transparent pill)
# ════════════════════════════════════════════════════════

sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
  sketchybar --add item space.$sid left \
    --subscribe space.$sid aerospace_workspace_change \
    --set space.$sid \
    icon.drawing=off \
    label.drawing=off \
    width=16 \
    background.drawing=on \
    background.color=0xdd192022 \
    background.height=35 \
    background.corner_radius=12 \
    click_script="aerospace workspace $sid" \
    script="$CONFIG_DIR/plugins/aerospace.sh $sid"
done

# A very subtle frosted container for the dots only
workspace_items=$(aerospace list-workspaces --all | sed 's/^/space./' | tr '\n' ' ')
sketchybar --add bracket workspace_island $workspace_items \
  --set workspace_island \
  background.color=0xdd192022 \
  background.corner_radius=10 \
  background.height=35

# ════════════════════════════════════════════════════════
#  LEFT — Front app  (plain floating text, separator)
# ════════════════════════════════════════════════════════

# Thin vertical separator between workspaces and app name
sketchybar --add item app_sep left \
  --set app_sep \
  icon.drawing=off \
  label="│" \
  label.color=0x00ffffff \
  label.font="CaskaydiaCove Nerd Font Mono:Semibold:14.0" \
  padding_left=12 \
  padding_right=12 \
  background.drawing=off

sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  background.height=35 \
  background.corner_radius=12 \
  background.color=0xdd192022 \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:14.0" \
  label.color=0xffcdd6f4 \
  label.padding_left=8 \
  label.padding_right=8 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# ════════════════════════════════════════════════════════
#  RIGHT - Volume, Battery, & Clock
# ════════════════════════════════════════════════════════

# Clock
sketchybar --add item clock right \
  --set clock \
  update_freq=10 \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:13.0" \
  label.color=0xffcdd6f4 \
  label.padding_left=0 \
  label.padding_right=10 \
  icon.padding_left=10 \
  icon.padding_right=0 \
  background.color=0xdd192022 \
  background.corner_radius=12 \
  background.height=35 \
  script="$PLUGIN_DIR/clock.sh"

# Battery
sketchybar --add item battery right \
  --set battery \
  update_freq=120 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:16.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:14.0" \
  icon.color=0xffcba6f7 \
  icon.padding_left=10 \
  icon.padding_right=4 \
  label.padding_left=4 \
  label.padding_right=10 \
  background.color=0xdd192022 \
  background.corner_radius=12 \
  background.height=35 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# Volume
sketchybar --add item volume right \
  --set volume \
  icon=󰕾 icon.color=0xffcba6f7 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:19.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:14.0" \
  label.color=0xffcdd6f4 \
  label.padding_left=4 \
  label.padding_right=10 \
  icon.padding_left=10 \
  icon.padding_right=4 \
  background.color=0xdd192022 \
  background.corner_radius=12 \
  background.height=35 \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

##### Force all scripts to run ###########################################
sketchybar --update
