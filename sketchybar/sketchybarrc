#!/bin/bash

source "$HOME/.config/sketchybar/colors.sh"

bar=(
  color=$BASE
  border_color=$SURFACE1
)

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar ################################################################
sketchybar --bar \
  position=top \
  height=37 \
  color=0x00000000 \
  shadow=off \
  padding_left=11 \
  padding_right=11 \
  display=all

##### Defaults ###########################################################
sketchybar --default \
  padding_left=3 \
  padding_right=3 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:13.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Medium:12.0" \
  icon.color=0xddffffff \
  label.color=0xddffffff \
  icon.padding_left=0 \
  icon.padding_right=4 \
  label.padding_left=0 \
  label.padding_right=0 \
  background.drawing=off \
  label.y_offset=0 \
  icon.y_offset=0

# ════════════════════════════════════════════════════════
#  LEFT — Workspace dots (pill island)
# ════════════════════════════════════════════════════════

for sid in 1 2 3 4 5 6; do
  sketchybar --add item space.$sid left \
    --set space.$sid \
    icon="•" \
    icon.font="CaskaydiaCove Nerd Font Mono:Bold:55.0" \
    icon.color=0xaa6c7086 \
    icon.padding_left=0 \
    icon.padding_right=7 \
    label.drawing=off \
    background.drawing=off \
    click_script="yabai -m space --focus $sid" \
    script="$CONFIG_DIR/plugins/space.sh" \
    --subscribe space.$sid space_change mouse.clicked
done

sketchybar --add bracket workspace_island \
  space.1 space.2 space.3 space.4 space.5 space.6 space.7 \
  --set workspace_island \
  background.drawing=on \
  background.color=0xdd192022 \
  background.height=35 \
  background.corner_radius=12 \
  padding_right=12

# ════════════════════════════════════════════════════════
#  LEFT — Front app (directly right of workspace island)
# ════════════════════════════════════════════════════════

sketchybar --add item front_app left \
  --set front_app \
  icon.drawing=off \
  background.height=35 \
  background.corner_radius=12 \
  background.color=0xdd192022 \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:14.0" \
  label.color=0xffcdd6f4 \
  label.padding_left=8 \
  label.padding_right=8 \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# Yabai signals for reliable front-app tracking
yabai -m signal --add event=application_front_switched action="sketchybar -m --set front_app label=\$(yabai -m query --windows --window | jq -r '.app')"
yabai -m signal --add event=window_focused action="sketchybar -m --set front_app label=\$(yabai -m query --windows --window | jq -r '.app')"

# ════════════════════════════════════════════════════════
#  RIGHT - Volume, Battery, & Clock
# ════════════════════════════════════════════════════════

# Clock
sketchybar --add item clock right \
  --set clock \
  update_freq=10 \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:13.0" \
  label.color=0xffcdd6f4 \
  label.padding_left=0 \
  label.padding_right=10 \
  icon.padding_left=10 \
  icon.padding_right=0 \
  background.color=0xdd192022 \
  background.corner_radius=12 \
  background.height=35 \
  script="$PLUGIN_DIR/clock.sh"

# Battery
sketchybar --add item battery right \
  --set battery \
  update_freq=120 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:16.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:14.0" \
  icon.color=0xffcba6f7 \
  icon.padding_left=10 \
  icon.padding_right=4 \
  label.padding_left=4 \
  label.padding_right=10 \
  background.color=0xdd192022 \
  background.corner_radius=12 \
  background.height=35 \
  script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

# Volume
sketchybar --add item volume right \
  --set volume \
  icon=󰕾 icon.color=0xffcba6f7 \
  icon.font="CaskaydiaCove Nerd Font Mono:Bold:19.0" \
  label.font="CaskaydiaCove Nerd Font Mono:Bold:14.0" \
  label.color=0xffcdd6f4 \
  label.padding_left=4 \
  label.padding_right=10 \
  icon.padding_left=10 \
  icon.padding_right=4 \
  background.color=0xdd192022 \
  background.corner_radius=12 \
  background.height=35 \
  script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change

##### Force all scripts to run ###########################################
sketchybar --update
